NOTESOLVE_IMAGE_TAG=latest
NOTESOLVE_API_IMAGE=ghcr.io/exelenta/notesolve-api
NOTESOLVE_WEB_IMAGE=ghcr.io/exelenta/notesolve-web

NOTESOLVE_AI_PROVIDER=openai
NOTESOLVE_OPENAI_API_KEY=
NOTESOLVE_OPENAI_MODEL=gpt-5.4
NOTESOLVE_OPENAI_VERIFICATION_MODEL=gpt-5.4
NOTESOLVE_OPENAI_NOTE_EDITOR_MODEL=gpt-5.4
NOTESOLVE_OPENAI_MAX_RETRIES=2
NOTESOLVE_VERIFICATION_ENABLED=true
NOTESOLVE_VERIFICATION_THRESHOLD=0.9

NOTESOLVE_DATA_DIR=/opt/notesolve/data
NOTESOLVE_VAULT_DIR=/opt/notesolve/vault
NOTESOLVE_BIND_ADDRESS=127.0.0.1
NOTESOLVE_WEB_PORT=8080
NOTESOLVE_ALLOWED_HOSTS=localhost,127.0.0.1,web
NOTESOLVE_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

